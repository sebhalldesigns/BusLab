<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:local="clr-namespace:BusLab.UI.Docking"
        mc:Ignorable="d"
        x:Class="BusLab.UI.Docking.TabArea">
    

    <Grid Name="RootGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="2*" MinWidth="100"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="*" MinWidth="100"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="100"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*" MinHeight="100"/>
        </Grid.RowDefinitions>

        <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="2" Background="{DynamicResource SemiColorBackground1}"/>

        <Grid Name="DocumentGrid" Grid.Column="2"/>

        <GridSplitter Grid.Column="3" Grid.RowSpan="3" Width="2" Background="{DynamicResource SemiColorBackground1}"/>


        <GridSplitter Grid.Column="2" Grid.Row="1" Height="2" Background="{DynamicResource SemiColorBackground1}"/>

    </Grid>

</UserControl>
