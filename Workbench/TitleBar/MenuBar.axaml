<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="BusLab.TitleBar.MenuBar"
        FontFamily="avares://BusLab/Assets/Fonts#Iosevka Regular">

    <UserControl.Styles>
        <Style Selector="MenuItem">
            <Setter Property="Padding" Value="5 2.5"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

        <Style Selector="MenuItem:selected /template/ Border">
            <Setter Property="Background" Value="{DynamicResource MenuHighlight}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

        <Style Selector="MenuItem:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource MenuHighlight}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

        <Style Selector="MenuItem:open /template/ Popup#PART_Popup > Border">
            <Setter Property="Background" Value="{DynamicResource MenuBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuPopupBorder}"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

        <Style Selector="MenuItem:empty:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource MenuPopupHighlight}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

        



    </UserControl.Styles>

    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="5">
        <TextBlock FontFamily="avares://BusLab/Assets/Fonts#Iosevka SemiBold" FontSize="16" VerticalAlignment="Center" Margin="10 0 -5 0">
            BusLab
        </TextBlock>
        <Menu  DockPanel.Dock="Left" Background="Transparent" IsHitTestVisible="True" VerticalAlignment="Center" Padding="5" CornerRadius="5">
            <MenuItem Header="_File">
                <MenuItem Header="New..."/>
                <Separator/>
                <MenuItem Header="Open..." HotKey="Ctrl+O"/>
                <MenuItem Header="Open Workspace..." HotKey="Ctrl+Shift+O"/>
                <Separator/>    
                <MenuItem Header="Save"/>
                <MenuItem Header="Save As..."/>
                <Separator/>
                <MenuItem Header="Settings" HotKey="Ctrl+,"/>    
                <Separator/>
                <MenuItem Header="_Exit"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Cut"/>
                <MenuItem Header="Copy"/>
                <MenuItem Header="Paste"/>
                <Separator/>
                <MenuItem Header="Find"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="New Window"/>
                <Separator/>
                <MenuItem Header="Open Workspace..."/>
                <MenuItem Header="Save Workspace As..."/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation"/>
                <Separator/>
                <MenuItem Header="About"/>
            </MenuItem>
        </Menu>
    </StackPanel>

</UserControl>
