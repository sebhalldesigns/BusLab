<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:local="clr-namespace:BusLab.Workbench"
        mc:Ignorable="d"
        x:Class="BusLab.Workbench.Explorer"
        FontFamily="avares://BusLab/Assets/Fonts#Iosevka Regular">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#20808080">
            <TextBlock VerticalAlignment="Center" Margin="5 0" FontSize="16" FontFamily="avares://BusLab/Assets/Fonts#Iosevka SemiBold">
                No Workspace
            </TextBlock>
        </Grid>
        

        <ScrollViewer Grid.Row="1">
        </ScrollViewer>
    </Grid>

</UserControl>
