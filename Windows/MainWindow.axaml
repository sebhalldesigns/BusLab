<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BusLab"
        xmlns:TitleBar="clr-namespace:BusLab.TitleBar"
        xmlns:ToolBar="clr-namespace:BusLab.ToolBar"
        xmlns:StatusBar="clr-namespace:BusLab.StatusBar"
        xmlns:Explorer="clr-namespace:BusLab.Explorer"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        MinWidth="750" MinHeight="500"
        Width="1600" Height="1000"
        x:Class="BusLab.MainWindow"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        FontFamily="avares://BusLab/Assets/Fonts#Iosevka Regular"
        Icon="avares://BusLab/Assets/Icons/icon.ico"
        Title="BusLab">

    <Window.Styles>
        <Style Selector="Window[WindowState=Maximized]">
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style Selector="Window[WindowState=Normal]">
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/> 
        </Grid.RowDefinitions>

        <TitleBar:TitleBar Grid.Row="0"/>        
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="500"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="3*" MinWidth="500"/>
            </Grid.ColumnDefinitions>
            
            <Explorer:Explorer Grid.Column="0"/>

            <GridSplitter Grid.Column="1" Width="2"/>

            <DockPanel Grid.Column="2">
                <ToolBar:ToolBar DockPanel.Dock="Top" Height="30"/>
                <Rectangle/>        
            </DockPanel>
        </Grid>

        <StatusBar:StatusBar Grid.Row="3"/>
    </Grid>
</Window>
